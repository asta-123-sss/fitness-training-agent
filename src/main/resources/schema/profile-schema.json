{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["heightCm", "weightKg", "gender", "injuries", "equipment", "targetMuscles", "daysPerWeek", "goal", "durationMinutes"],
  "properties": {
    "heightCm": { "type": "number", "minimum": 100, "maximum": 250 },
    "weightKg": { "type": "number", "minimum": 20, "maximum": 300 },
    "gender": { "type": "string", "enum": ["男", "女"] },
    "age": { "type": "integer", "minimum": 10, "maximum": 100 },
    "injuries": { "type": "array", "items": { "type": "string" } },
    "equipment": { "type": "array", "items": { "type": "string" } },
    "targetMuscles": { "type": "array", "items": { "type": "string" } },
    "daysPerWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
    "goal": { "type": "string", "enum": ["增肌", "减脂", "维持", "塑形"] },
    "durationMinutes": { "type": "integer", "minimum": 10, "maximum": 240 }
  }
}
