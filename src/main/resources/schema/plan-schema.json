{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["goal", "weeklyPlan"],
  "properties": {
    "goal": { "type": "string" },
    "weeklyPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["day", "focus", "exercises"],
        "properties": {
          "day": { "type": "string" },
          "focus": { "type": "string" },
          "exercises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "sets", "reps", "restSeconds"],
              "properties": {
                "name": { "type": "string" },
                "sets": { "type": "integer" },
                "reps": { "type": "string" },
                "restSeconds": { "type": "integer" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "dietAdvice": { "type": "string" },
    "notes": { "type": "string" }
  }
}
